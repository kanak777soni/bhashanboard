# Neon pooled PostgreSQL connection string. Keep this server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required to open /admin. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional canonical public URL used by the sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development only. Never enable this in production.
# ALLOW_INSECURE_ADMIN=true
