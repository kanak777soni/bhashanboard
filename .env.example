# Restricted runtime Neon connection string. Keep this server-only. In
# production grant only the tables/actions used by the application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional migration-owner connection used only by local db:* and admin:promote
# commands. If omitted, those commands fall back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for registered accounts. Generate at least 32 random bytes and keep
# it stable; changing it invalidates every session.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Canonical public URL used by links, metadata, auth callbacks and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 for administrator-uploaded, rights-cleared MP4 excerpts.
# Use two separate buckets with one least-privilege token scoped only to object
# read/write in both. The upload bucket is private quarantine and must never
# have a public domain. R2_PUBLIC_BASE_URL is the public bucket's HTTPS custom
# domain (no trailing slash). All credential and bucket values are server-only.
R2_ACCOUNT_ID=replace-with-your-32-character-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_UPLOAD_BUCKET_NAME=bhashanboard-video-quarantine
R2_PUBLIC_BUCKET_NAME=bhashanboard-video-public
R2_PUBLIC_BASE_URL=https://media.example.com

# Public, monitored inbox for privacy and account-data requests. Until this is
# configured, the privacy page displays an invitation-only pre-launch process.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.example

# Keep search engines out and show the pre-launch notice. Set to false only
# after the publication workflow and first records are ready for launch.
SITE_PRELAUNCH=true

# At least 24 random characters. Vercel Cron sends this as a Bearer token to
# the daily operational-retention endpoint.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Brevo transactional mail. Verify BREVO_SENDER_EMAIL in Brevo first.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=committee@example.com
BREVO_SENDER_NAME=The Bhashan Board

# Optional Brevo transactional templates. Without these IDs, the application
# sends its built-in HTML/text verification, reset and welcome emails.
# BREVO_VERIFY_TEMPLATE_ID=1
# BREVO_RESET_TEMPLATE_ID=2
# BREVO_WELCOME_TEMPLATE_ID=3

# No browser bootstrap secret is used. After the first account is verified,
# promote it once from a trusted terminal with:
# npm run admin:promote -- verified-user@example.com
