# Restricted runtime Neon connection string. Keep this server-only. In
# production grant only the tables/actions used by the application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional migration-owner connection used only by local db:* and admin:promote
# commands. If omitted, those commands fall back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for registered accounts. Generate at least 32 random bytes and keep
# it stable; changing it invalidates every session.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Canonical public URL used by links, metadata, auth callbacks and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary for administrator-uploaded, rights-cleared video excerpts. Create
# a SIGNED, AUTHENTICATED video upload preset (never unsigned), capped at
# 52,428,800 bytes and restricted to mp4,mov,webm. Leave its eager/incoming
# transformations and folder/public-ID rewriting empty; the server validates
# these preset settings through Cloudinary's Admin API before authorizing an
# upload. Keep all four values out of NEXT_PUBLIC_ variables. The cloud name,
# API key and signed-preset name necessarily appear in each authorized browser
# upload; the API secret never leaves the server.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
CLOUDINARY_VIDEO_UPLOAD_PRESET=bhashanboard-video

# Public, monitored inbox for privacy and account-data requests. Until this is
# configured, the privacy page displays an invitation-only pre-launch process.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@your-domain.example

# Keep search engines out and show the pre-launch notice. Set to false only
# after the publication workflow and first records are ready for launch.
SITE_PRELAUNCH=true

# At least 24 random characters. Vercel Cron sends this as a Bearer token to
# the daily operational-retention endpoint.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required Brevo transactional-mail settings. Create an API key with
# transactional-email access and verify BREVO_SENDER_EMAIL (or its domain) in
# Brevo before account registration is opened.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=committee@example.com

# Optional display name. Defaults to "The Bhashan Board".
# BREVO_SENDER_NAME=The Bhashan Board

# Optional Brevo transactional template IDs. Leave them unset unless you have
# tested the templates: verification/reset receive {{ params.name }} and
# {{ params.actionUrl }}; welcome receives {{ params.name }} and
# {{ params.siteUrl }}. The first two must render actionUrl as a clickable link.
# BREVO_VERIFY_TEMPLATE_ID=1
# BREVO_RESET_TEMPLATE_ID=2
# BREVO_WELCOME_TEMPLATE_ID=3

# There is deliberately no ADMIN_PASSWORD, admin username, or browser bootstrap
# secret. Sign up normally with the email that should own the first admin
# account, follow its Brevo verification link, then promote that verified
# account once from a trusted terminal:
# npm run admin:promote -- verified-user@example.com
